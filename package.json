{
  "name": "agent-game-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event-sourced game runtime with Pi Agent as the only agent integration layer.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:modules": "node scripts/check-module-boundaries.mjs",
    "start": "npm.cmd run build && node dist/app/main.js",
    "test": "npm.cmd run build && node --test dist/**/*.test.js",
    "import:atlas:fuyuki": "node scripts/download-atlas-fuyuki.mjs",
    "index:atlas:fuyuki": "npm.cmd run build && node scripts/index-atlas-fuyuki.mjs",
    "import:atlas:canon": "node scripts/download-atlas-canon.mjs",
    "index:atlas:canon": "npm.cmd run build && node scripts/index-atlas-canon.mjs",
    "import:atlas:servants": "node scripts/download-atlas-servants.mjs",
    "index:atlas:servants": "npm.cmd run build && node scripts/index-atlas-servants.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.12"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "7.0.2"
  }
}
